rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Корень пользователя: настройки, версия структуры и старое поле archive (до версии 3.0.0)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Месяцы архива: users/{uid}/months/YYYY-MM.
      // Проверка id только на запись: запрос списка всей подколлекции не может доказать формат id каждого документа
      match /months/{month} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if request.auth != null
          && request.auth.uid == uid
          && month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
      }
    }
  }
}
